+/* 0199: the stage-4 LPG setup alone (checks, every write read back), output left on. 0 = ready. */
+static int
+spes_vib_lpg_setup(void)
+{
+	uint8_t type = 0, sub = 0;
+	if (sweet_spmi_init() != 0 || sweet_spmi_read(SPES_LPG_SID, SPES_LPG_BASE + 4, &type) != 0 ||
+	    sweet_spmi_read(SPES_LPG_SID, SPES_LPG_BASE + 5, &sub) != 0 || type != 0x13 || sub != 0x0b) {
+		printf("SPES HAPTIC: LPG not as expected (type %#x subtype %#x)\n", type, sub);
+		return -1;
+	}
+	lpg_log("before (haptic)");
+	int err = 0;
+	err = err ? err : lpg_masked(SPES_LPG_SIZE_CLK, SPES_LPG_SIZE_CLK_MASK, SPES_LPG_SIZE_CLK_VAL);
+	err = err ? err : lpg_masked(SPES_LPG_PREDIV_CLK, SPES_LPG_PREDIV_MASK, SPES_LPG_PREDIV_VAL);
+	err = err ? err : lpg_masked(SPES_LPG_VALUE_MSB, SPES_LPG_MSB_MASK, (uint8_t)(SPES_LPG_VALUE >> 8));
+	err = err ? err : lpg_put(SPES_LPG_VALUE_LSB, (uint8_t)(SPES_LPG_VALUE & 0xff), true);
+	err = err ? err : lpg_put(SPES_LPG_SYNC, 0x01, false);
+	err = err ? err : lpg_masked(SPES_LPG_TYPE_CONFIG, SPES_LPG_GLITCH_BIT, SPES_LPG_GLITCH_BIT);
+	if (!err) {
+		uint8_t old = 0, back = 0xff, want;
+		err = sweet_spmi_read(SPES_LPG_SID, SPES_LPG_ENABLE, &old) != 0 ? -1 : 0;
+		want = spes_lpg_masked(old, SPES_LPG_ENABLE_MASK, SPES_LPG_ENABLE_ON);
+		err = err ? err : lpg_put(SPES_LPG_ENABLE, want, false);
+		err = err ? err : (sweet_spmi_read(SPES_LPG_SID, SPES_LPG_ENABLE, &back) != 0 ? -1 : 0);
+		if (!err && (back & SPES_LPG_ENABLE_KEPT) != (want & SPES_LPG_ENABLE_KEPT)) {
+			err = -1;
+		}
+	}
+	lpg_log(err ? "haptic setup FAILED" : "haptic: PWM on, motor follows GPIO 36");
+	return err;
+}
