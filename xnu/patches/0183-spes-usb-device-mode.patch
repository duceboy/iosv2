+/*
+ * 0183: USB (bsd/dev/sweet_usb.c) and the modem thread may both look for a free SMR/context bank;
+ * one at a time, or both could take the same slot. A spin flag (no lock object to allocate early).
+ */
+static volatile UInt32 smmu_busy;
+
 static bool
 smmu_identity(uint32_t sid, uint32_t mask, const char *name)
+{
+	while (!OSCompareAndSwap(0, 1, &smmu_busy)) {
+		IOSleep(1);
+	}
+	bool ok = smmu_identity_locked(sid, mask, name);
+	OSCompareAndSwap(1, 0, &smmu_busy);
+	return ok;
+}
