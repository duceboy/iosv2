 extern void spes_cpufreq_init(void);   /* bsd/dev/spes_cpufreq.c (spescpufreq=0 off) */
+extern void spes_usb_probe(void);     /* bsd/dev/spes_usb.c (spesusb=1, reads only) */
 extern void spes_amp_init(void);       /* bsd/dev/spes_amp.c (spesamp=1) */
 extern void sweet_touch_init(void);
 extern void sweet_usb_probe(void);
@@ -788,6 +789,7 @@ sweet_ufs_init(void)
 		spes_cpufreq_init();
