diff --git a/bsd/dev/spes_usb.c b/bsd/dev/spes_usb.c
new file mode 100644
index 0000000..1031929
--- /dev/null
+++ b/bsd/dev/spes_usb.c
@@ -0,0 +1,126 @@
+/*
+ * spes/spesn USB, step 1: a look, reading only (boot-arg spesusb=1; nothing happens without it).
+ *
+ * The inherited USB driver (bsd/dev/sweet_usb.c, patches 0072-0077) is written for sweet's SM7150
+ * and stays disabled here. This file only reports the state ABL leaves SM6225's USB in after
+ * `fastboot boot`, as sweet's own step 1 did, so that the driver can be moved over with numbers
+ * seen on the phone. It writes no register, and reads a block only when the status registers say
+ * its power domain and clocks are on (a load from a gated block hangs the bus).
+ *
+ * Where the numbers come from (Xiaomi's kernel for spes, not yet compared with a live device tree):
+ *   khaje.dtsi          gcc: clock-controller@1400000
+ *   bengal-gdsc.dtsi    gcc_usb30_prim_gdsc: qcom,gdsc@141a004          -> GCC + 0x1a004
+ *   gcc-khaje.c         usb30_prim_master 0x1a010, sleep 0x1a014, mock_utmi 0x1a018,
+ *                       sys_noc_usb3_prim_axi 0x1a080, cfg_noc_usb3_prim_axi 0x1a084,
+ *                       ahb2phy_usb 0x1d008, usb3_prim_clkref 0x9f000 (all BRANCH_HALT: bit 31 = off)
+ *   khaje-usb.dtsi      ssusb@4e00000 (wrapper, 0x100000), dwc3@4e00000 (core, 0xe000),
+ *                       hsphy@1613000 qcom,usb-hsphy-snps-femto (0x110)
+ *   dwc3-msm            QSCRATCH = core base + 0xf8800 (sweet_usb.c uses the same rule)
+ *   phy-msm-snps-hs.c   UTMI_CTRL0 0x3c, UTMI_CTRL5 0x50, HS_PHY_CTRL_COMMON0 0x54, HS_PHY_CTRL2 0x64,
+ *                       PARAMETER_OVERRIDE_X0..X2 0x6c/0x70/0x74, CFG0 0x94, REFCLK_CTRL 0xa0
+ *
+ * Each block is mapped one page at a time: io_map is 8 MB and never gives a map back (spes_amp.c).
+ *
+ * Status: WRITTEN, NOT RUN. Not compiled in the kernel build yet.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void spes_usb_probe(void);
+
+#define SU_GCC_PA       0x01400000u
+#define SU_GDSCR        0x1a004u        /* bit 31: power on */
+#define SU_DWC3_PA      0x04e00000u
+#define SU_QSCRATCH     0x000f8800u
+#define SU_HSPHY_PA     0x01613000u
+#define SU_CLK_OFF      (1u << 31)
+
+static const struct {
+	const char *name;
+	uint32_t    off;
+} su_cbcr[] = {
+	{ "master", 0x1a010u },
+	{ "sleep", 0x1a014u },
+	{ "mock-utmi", 0x1a018u },
+	{ "sys-noc-axi", 0x1a080u },
+	{ "cfg-noc-axi", 0x1a084u },
+	{ "ahb2phy", 0x1d008u },
+	{ "clkref", 0x9f000u },
+};
+
+static uint32_t
+su_rd(vm_offset_t page, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(page + (off & 0xfffu));
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* the 4 KB page of a block that holds off, or 0 */
+static vm_offset_t
+su_page(uint32_t pa, uint32_t off)
+{
+	return ml_io_map((pa + off) & ~0xfffu, 0x1000u);
+}
+
+void
+spes_usb_probe(void)
+{
+	int on = 0;
+	if (!PE_parse_boot_argn("spesusb", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	vm_offset_t g1a = su_page(SU_GCC_PA, 0x1a000u), g1d = su_page(SU_GCC_PA, 0x1d000u),
+	    g9f = su_page(SU_GCC_PA, 0x9f000u);
+	if (g1a == 0 || g1d == 0 || g9f == 0) {
+		printf("SPES USB: no GCC mapping\n");
+		return;
+	}
+	uint32_t gdscr = su_rd(g1a, SU_GDSCR);
+	uint32_t cbcr[sizeof(su_cbcr) / sizeof(su_cbcr[0])];
+	printf("SPES USB: GDSC usb30_prim %#x (%s)\n", gdscr, (gdscr & (1u << 31)) ? "on" : "off");
+	for (unsigned i = 0; i < sizeof(su_cbcr) / sizeof(su_cbcr[0]); i++) {
+		uint32_t off = su_cbcr[i].off;
+		cbcr[i] = su_rd(off < 0x1b000u ? g1a : off < 0x1e000u ? g1d : g9f, off);
+		printf("SPES USB: clk %-12s CBCR %#x (%s)\n", su_cbcr[i].name, cbcr[i],
+		    (cbcr[i] & SU_CLK_OFF) ? "off" : "on");
+	}
+	/* The controller's registers need the power domain, the master clock and the config-NoC path. */
+	if (!(gdscr & (1u << 31)) || (cbcr[0] & SU_CLK_OFF) || (cbcr[4] & SU_CLK_OFF)) {
+		printf("SPES USB: controller unpowered or unclocked; DWC3 not read\n");
+	} else {
+		vm_offset_t dwc = su_page(SU_DWC3_PA, 0xc000u), qs = su_page(SU_DWC3_PA, SU_QSCRATCH);
+		if (dwc == 0 || qs == 0) {
+			printf("SPES USB: no DWC3 mapping\n");
+			return;
+		}
+		printf("SPES USB: DWC3 GSNPSID %#x GCTL %#x GSTS %#x GUSB2PHYCFG %#x GHWPARAMS0 %#x\n",
+		    su_rd(dwc, 0xc120), su_rd(dwc, 0xc110), su_rd(dwc, 0xc118), su_rd(dwc, 0xc200),
+		    su_rd(dwc, 0xc140));
+		printf("SPES USB: DWC3 DCFG %#x DCTL %#x DEVTEN %#x DSTS %#x DALEPENA %#x\n",
+		    su_rd(dwc, 0xc700), su_rd(dwc, 0xc704), su_rd(dwc, 0xc708), su_rd(dwc, 0xc70c),
+		    su_rd(dwc, 0xc720));
+		printf("SPES USB: DWC3 GEVNTADR %#x:%#x GEVNTSIZ %#x GEVNTCOUNT %#x\n",
+		    su_rd(dwc, 0xc404), su_rd(dwc, 0xc400), su_rd(dwc, 0xc408), su_rd(dwc, 0xc40c));
+		printf("SPES USB: QSCRATCH HS_PHY_CTRL %#x SS_PHY_CTRL %#x\n",
+		    su_rd(qs, SU_QSCRATCH + 0x10u), su_rd(qs, SU_QSCRATCH + 0x30u));
+	}
+	if (cbcr[5] & SU_CLK_OFF) {
+		printf("SPES USB: ahb2phy clock off; HS PHY not read\n");
+		return;
+	}
+	vm_offset_t phy = su_page(SU_HSPHY_PA, 0);
+	if (phy == 0) {
+		return;
+	}
+	printf("SPES USB: HSPHY UTMI_CTRL0 %#x UTMI_CTRL5 %#x COMMON0 %#x CTRL2 %#x CFG0 %#x REFCLK %#x\n",
+	    su_rd(phy, 0x3c), su_rd(phy, 0x50), su_rd(phy, 0x54), su_rd(phy, 0x64), su_rd(phy, 0x94),
+	    su_rd(phy, 0xa0));
+	printf("SPES USB: HSPHY override X0 %#x X1 %#x X2 %#x (stock DT: 0x61 0x08 0x2d)\n",
+	    su_rd(phy, 0x6c), su_rd(phy, 0x70), su_rd(phy, 0x74));
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
