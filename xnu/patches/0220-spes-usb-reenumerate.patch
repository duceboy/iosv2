+/*
+ * 0220: bus reset or disconnect while configured (all-14, 2026-11-18: a VM on the Mac took the device
+ * and gave it back; the Mac enumerated it again, en3 stayed "inactive"). The first configuration's
+ * transfers and data toggles were still in place: SET_CONFIGURATION did nothing (already configured)
+ * and the NETWORK_CONNECTION notification went out with the old toggle, which the host drops.
+ * As Linux dwc3_gadget_reset_interrupt/dwc3_stop_active_transfers: end what runs on the data
+ * endpoints and forget the configuration; the next SET_CONFIGURATION sets the endpoints up again
+ * (SETEPCONFIG "init" starts at DATA0) and re-arms reception.
+ */
+static void
+ud_deconfigure(const char *why)
+{
+	static const unsigned eps[] = { EP_RX, EP_TX, EP_INT };
+
+	if (!ud.configured) {
+		return;
+	}
+	lck_mtx_lock(ud.lock);
+	ud.configured = false;
+	ud.tx_busy = false;
+	lck_mtx_unlock(ud.lock);
+	ud.data_alt = 0;
+	for (unsigned i = 0; i < 3; i++) {
+		unsigned ep = eps[i];
+		if (ud_rsc[ep] != 0) {
+			(void)ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_HIPRI_FORCERM | ((uint32_t)ud_rsc[ep] << 16), 0, 0, 0);
+			ud_rsc[ep] = 0;
+			delay(100);
+		}
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	printf("SWEET USB: %s while configured: data endpoints stopped, waiting for SET_CONFIGURATION\n", why);
+}
+
 /* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
 static void
