+/*
+ * 0225: a sample now, from the USB command server's thread. names: comma separated process
+ * names, or NULL/"" for the boot-arg's (the default list if the sampler is off or not yet up).
+ */
+void sweet_sample_now(const char *names);
+void
+sweet_sample_now(const char *names)
+{
+	static char wanted[128];
+	if (names != NULL && names[0] != 0) {
+		strlcpy(wanted, names, sizeof(wanted));
+	} else if (sweet_sample_names[0] != 0 && sweet_sample_names[0] != '-') {
+		strlcpy(wanted, sweet_sample_names, sizeof(wanted));
+	} else {
+		strlcpy(wanted, "SpringBoard,backboardd", sizeof(wanted));
+	}
+	printf("SMP --- sample on request: %s\n", wanted);
+	proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, wanted, NULL, NULL);
+}
