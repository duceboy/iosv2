+
+struct ipa_chan {
+	const char      *name;
+	uint8_t         ch, ev, ep;             /* GSI channel, event ring (Linux allocates lowest free in endpoint-name order), IPA endpoint */
+	bool            tx, command, qmap, aggr, close_eof, status;
+	uint8_t         pad_align, status_ep;
+	uint16_t        seq;                    /* ENDP_INIT_SEQ (TX only) */
+	uint32_t        slots, tlv, buf_size;
+	uint32_t        max_out;                /* outstanding TREs: slots - (tlv - 1) (Linux gsi_channel_tre_max()), at most slots - 1 */
+	struct ipa_dma  ring, evring, bufs;
+	uint32_t        next;                   /* next TRE index to fill (free running) */
+	uint32_t        done;                   /* next TRE index whose completion is expected */
+	uint32_t        events;                 /* next event index to read */
+	bool            started;
+	uint64_t        packets, bytes, drops, errors;
+};
