+/* ---------------------------------------------------------------- state */
+
+struct ipa_dma {
+	uint8_t         *va;
+	uint64_t        pa;
+	uint32_t        size;
+};
+
+struct gsi_tre {
+	uint64_t        addr;
+	uint16_t        len_opcode;
+	uint16_t        reserved;
+	uint32_t        flags;
+} __attribute__((packed));
+
+struct gsi_event {
+	uint64_t        xfer_ptr;
+	uint16_t        len;
+	uint8_t         reserved1;
+	uint8_t         code;
+	uint16_t        reserved2;
