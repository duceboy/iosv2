 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/* 0207: the reset path of the "fastboot"/"reboot" commands, shared with the countdown (spesautofb=) */
+static void
+ud_reset(bool bootloader)
+{
+	/*
+	 * 0188: twice, with time for HFS's journal and the UFS cache in between. 0205: on a helper
+	 * thread, waited for at most 8 s: with the ADSP and the modem up (all-1, all-3) the command
+	 * thread never came back from sync_internal() and the phone never reset.
+	 */
+	ud_sync_done = 0;
+	{
+		thread_t st;
+		if (kernel_thread_start(ud_sync_thread, NULL, &st) == KERN_SUCCESS) {
+			thread_deallocate(st);
+			for (int w = 0; w < 80 && !ud_sync_done; w++) {
+				ud_sleep_ms(100);
+			}
+		}
+	}
+	printf("SWEET USB: sync %s\n", ud_sync_done ? "done" : "still running after 8 s: resetting anyway");
+	ud_sleep_ms(500);                   /* reply and last log lines out over USB */
+	if (bootloader) {
+		vm_offset_t imem = ml_io_map(SPES_IMEM_PAGE, 0x1000);
+		if (imem != 0 && usb_soc.spes) {
+			*(volatile uint32_t *)(imem + SPES_IMEM_RESTART) = RESTART_BOOTLOADER;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			printf("SWEET USB: IMEM restart_reason %#x\n", *(volatile uint32_t *)(imem + SPES_IMEM_RESTART));
+		}
+	}
+	/* 0207: shut the modem and the ADSP down first (Linux stops its remoteprocs on reboot); all-5 reset with both up
+	 * but never reached fastboot */
+	{
+		extern void spes_dsps_shutdown(void);
+		spes_dsps_shutdown();
+	}
+	printf("SWEET USB: PSCI SYSTEM_RESET\n");
+	ud_sleep_ms(300);
+	ud_psci_reset();
+}
+
+/*
+ * 0207, spesautofb=N: after N minutes of running, go to fastboot by itself (PON reason, bounded syncs, reset), so a
+ * test boot never runs forever and the next one needs no hands (user's idea, 2026-11-17). 0 = off.
+ */
+static void
+ud_autofb_thread(void *arg __unused, wait_result_t w __unused)
+{
+	uint32_t minutes = (uint32_t)(uintptr_t)arg;
+	for (uint32_t m = 0; m < minutes; m++) {
+		if (minutes - m <= 3 || (minutes - m) % 10 == 0) {
+			printf("SWEET USB: countdown: fastboot in %u min\n", minutes - m);
+		}
+		ud_sleep_ms(60000);
+	}
+	printf("SWEET USB: countdown over: going to fastboot\n");
+	if (usb_soc.spes && spes_pon_set_bootloader() != 0) {
+		printf("SWEET USB: countdown: PON reason not set, no reset\n");
+		(void)thread_terminate(current_thread());
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	ud_reset(true);
+}
+
