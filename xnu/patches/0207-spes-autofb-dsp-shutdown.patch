+/* 0207: PAS shutdown of the modem and the ADSP before a reset (sweet_usb.c ud_reset). Only what was booted. */
+extern "C" void spes_dsps_shutdown(void);
+extern "C" void
+spes_dsps_shutdown(void)
+{
+	uint64_t res = 0, st;
+	if (g_modem_up) {
+		st = scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, PAS_ID_MODEM, 0, 0, &res);
+		printf("SpesModem: modem PAS shutdown before reset: ret=%llx res=%llx\n", st, res);
+	}
+	st = scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, 1 /* ADSP PAS id */, 0, 0, &res);
+	printf("SpesModem: ADSP PAS shutdown before reset: ret=%llx res=%llx\n", st, res);
+}
