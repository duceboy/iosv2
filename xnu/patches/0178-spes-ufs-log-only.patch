 		return EROFS;
 	}
+	/* Log-only (0178): additionally WRITE(10) and SYNCHRONIZE CACHE; LBAs are checked in ufs_write_blocks. */
+	if (spes_log_only && cdb[0] != 0x00 && cdb[0] != 0x28 && cdb[0] != 0x2a && cdb[0] != 0x35) {
