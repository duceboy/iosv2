@@ -293,6 +308,11 @@ ufs_write_blocks(uint64_t lba, uint32_t count)
 		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
 		return EPERM;
 	}
+	if (spes_log_only && !spes_ufs_log_write_ok(lba, count, su.first_block, su.nblocks, spes_log_lo)) {
+		printf("SWEET UFS: log-only, refusing write of %u blocks at 0x%llx (log 0x%llx..0x%llx)\n",
+		    count, lba, spes_log_lo, su.first_block + su.nblocks - 1);
+		return EPERM;
+	}
 	uint8_t cdb[10] = {
 		0x2a, 0,
 		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
@@ -760,6 +780,13 @@ sweet_ufs_init(void)
 	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
 	/* Only now, with the partition bounds known, can writes be allowed. */
 	su.writable = !spes_readonly_probe && (rw != 0);
+	if (spes_log_only) {
+		/* the same area sweet_log_thread writes: the last SWEET_LOG_BLOCKS blocks (GPT bounds) */
+		spes_log_lo = spes_ufs_log_lo(su.first_block, su.nblocks, 1 + (4u << 20) / UFS_BLOCK);
+		su.writable = spes_log_lo != 0;
+		printf("SWEET UFS: log-only, writes limited to blocks 0x%llx..0x%llx\n",
+		    spes_log_lo, su.first_block + su.nblocks - 1);
+	}
 	su.ready = true;
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
@@ -768,6 +795,9 @@ sweet_ufs_init(void)
 		return 0; /* no log, sampling or input drivers during this probe */
 	}
 	sweet_log_start();
+	if (spes_log_only) {
+		return 0; /* 0178: RAM diagnostic: the log only; drivers stay off as in the probe */
+	}
 	sweet_sample_start();
 	/*
 	 * Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp).
@@ -816,6 +846,8 @@ sweet_ufs_init(void)
  */
 #define SWEET_LOG_SIZE          (4u << 20)
 #define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
+/* 0178: the log-only bounds (spes_ufs_log_lo in sweet_ufs_init) assume exactly this size */
+_Static_assert(SWEET_LOG_BLOCKS == 1 + (4u << 20) / UFS_BLOCK, "0178 log-only area != sweetlog area");
 #define SWEET_LOG_SECS          10u
 
 static char sweet_log_ring[SWEET_LOG_SIZE];
@@ -952,12 +984,32 @@ spes_ufs_probe(void)
