+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0185: log the PM6125 PON registers the "reboot to fastboot" reason would use, READ ONLY: revision
+ * (0x801), type (0x804), subtype (0x805; 4/5 = gen2) and SOFT_RB_SPARE (0x88F), plus the value the
+ * allow-listed write (spes_spmi_allow.h) would put there. Nothing is written in this patch.
+ */
+void spes_pon_log(void);
+void
+spes_pon_log(void)
+{
+	uint8_t rev = 0, type = 0, sub = 0, spare = 0;
+	if (sweet_spmi_init() != 0) {
+		printf("SPES PON: SPMI not available\n");
+		return;
+	}
+	bool ok = sweet_spmi_read(0, 0x801, &rev) == 0 && sweet_spmi_read(0, 0x804, &type) == 0 &&
+	    sweet_spmi_read(0, 0x805, &sub) == 0 && sweet_spmi_read(0, SPES_PON_SOFT_RB_SPARE, &spare) == 0;
+	if (!ok) {
+		printf("SPES PON: read failed\n");
+		return;
+	}
+	int want = spes_pon_bootloader_value(spare, sub);
+	printf("SPES PON: rev %#x type %#x subtype %#x (%s) SOFT_RB_SPARE 0x88f = %#x; bootloader value would be %s%#x\n",
+	    rev, type, sub, (sub == 4 || sub == 5) ? "gen2" : "not gen2", spare, want < 0 ? "none, " : "", want < 0 ? 0 : want);
+}
+#endif
