 		static uint32_t failed_props;
 		if (ret != kIOReturnSuccess && failed_props < 8) {
-			OSSerialize *fser = OSSerialize::withCapacity(1024);
+			/* 0190: one short line per key (whole dictionaries were cut after ~300 characters) */
 			failed_props++;
-			IOLog("SWEET SURF: refused %s request #%u (0x%x): %.900s\n", name, failed_props, ret,
-			    fser != NULL && props->serialize(fser) ? fser->text() : "(no text)");
-			OSSafeReleaseNULL(fser);
+			IOLog("SWEET SURF: refused %s request #%u (0x%x), %u keys:\n", name, failed_props, ret,
+			    props->getCount());
+			OSCollectionIterator *it = OSCollectionIterator::withCollection(props);
+			OSSymbol *key;
+			while (it != NULL && (key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+				OSObject *v = props->getObject(key);
+				OSNumber *n = OSDynamicCast(OSNumber, v);
+				OSArray *a = OSDynamicCast(OSArray, v);
+				OSData *d = OSDynamicCast(OSData, v);
