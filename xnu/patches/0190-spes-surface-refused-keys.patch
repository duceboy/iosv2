+					IOLog("SWEET SURF:  #%u %s = %s%s%u\n", failed_props, key->getCStringNoCopy(),
+					    v != NULL ? v->getMetaClass()->getClassName() : "null",
+					    a != NULL ? " count " : (d != NULL ? " bytes " : " "),
+					    a != NULL ? a->getCount() : (d != NULL ? d->getLength() : 0));
