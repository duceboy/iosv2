+/*
+ * spes (0173, boot-arg spesbattery=1): the battery chips on QUP0 SE1, READ ONLY. Nothing is
+ * written to any of them; charging is left to the hardware as the bootloader set it up.
+ *
+ * There are two spes boards (Xiaomi's kernel, arch/arm64/boot/dts/vendor/qcom):
+ *   spes.dtsi, board-id 0x20022: Maxim max77729 at 0x66 (top), its charger at 0x69 and its
+ *     fuel gauge at 0x36 (drivers/mfd/maxim/max77729.c: 0xD2 >> 1 and 0x6C >> 1), sc8551 at 0x65;
+ *   spes-sm5602.dtsi, board-id 0x40022: SM5602 gauge at 0x71 and a bq2589x charger at 0x6a,
+ *     the pair Topaz has (topaz 0091), sc8551 at 0x66.
+ * Which board this is, is found by which gauge answers.
+ *
+ * max77729 gauge (ModelGauge m5; 16-bit registers, low byte first), numbers from Xiaomi's
+ * drivers/power/supply/maxim/max77729_fuelgauge.c and the DT (fuelgauge,fg_resistor = 2):
+ *   0x06 SOCREP   percent in the high byte, 1/256 % in the low  (max77729_fg_read_soc)
+ *   0x09 VCELL    78.125 uV per count                            (max77729_fg_read_vcell)
+ *   0x0A CURRENT  signed, 15625 * fg_resistor / 100 uA per count = 0.3125 mA; Linux reports it
+ *                 as is for POWER_SUPPLY current_now, where Xiaomi's sign is + while charging
+ *                 -- to be confirmed against Android (the log prints the raw word)
+ *   0x08 TEMP     signed, 1/256 degC per count                   (max77729_fg_read_temp)
+ *   0x17 CYCLES   1/100 cycle per count                          (max77729_fg_read_cycle)
+ * max77729 charger (max77729_charger.h):
+ *   0xB2 CHG_INT_OK   bit 6 CHGIN_OK: a valid input is on the USB port
+ *   0xB4 CHG_DTLS_01  bits 3:0: 0..3 charging (prequal, CC, CV, top-off), 4 done, 5..7 not
+ *                     charging, 8 off                            (max77729_get_charger_state)
+ */
+bool
+SweetBattery::spesWord(uint8_t addr, uint8_t reg, uint16_t *value)
+{
+	uint8_t w[2] = { 0, 0 };
+	if (spes_i2c1_read(addr, reg, w, 2) != 0) {
+		return false;
+	}
+	*value = (uint16_t)((unsigned)w[0] | ((unsigned)w[1] << 8));
+	return true;
+}
+
+bool
+SweetBattery::pollSpesMax(void)
+{
+	uint16_t soc, vcell, cur, temp = 0, cycles = 0;
+	if (!spesWord(0x36, 0x06, &soc) || !spesWord(0x36, 0x09, &vcell) ||
+	    !spesWord(0x36, 0x0a, &cur)) {
+		return false;
+	}
+	bool tempOk = spesWord(0x36, 0x08, &temp);
+	bool cyclesOk = spesWord(0x36, 0x17, &cycles);
+	uint8_t ok = 0, dtls = 0;
+	bool chgOk = spes_i2c1_read(0x69, 0xb2, &ok, 1) == 0 &&
+	    spes_i2c1_read(0x69, 0xb4, &dtls, 1) == 0;
+
+	unsigned percent = (soc >> 8) + ((soc & 0xffu) >= 0x80u ? 1u : 0u);
+	unsigned mv = (unsigned)(((uint64_t)vcell * 78125u) / 1000000u);
+	int ma = (int)(((int64_t)(int16_t)cur * 3125) / 10000);
+	if (percent > 101 || mv < 2800 || mv > 4600) {
+		return false;   /* an unprogrammed or absent gauge must not become a flat battery */
+	}
+	if (percent > 100) {
+		percent = 100;
+	}
+	if (tempOk) {
+		int centi = ((int)(int16_t)temp * 100) / 256;
+		if (centi > -3000 && centi < 9000) {
+			fTempCentiC = centi < 0 ? 0 : centi;
+			fTempMeasured = true;
+		}
+	}
+	unsigned state = dtls & 0x0fu;
+	bool external = chgOk && (ok & 0x40u) != 0;
+	bool charging = external && state <= 3;
+	bool done = external && state == 4;
+	if (cyclesOk) {
+		fCycles = cycles / 100u;
+	}
+	publish(done ? 100 : percent, mv, ma, external, external, charging, done, true, true);
+	if (fSpesLogs++ % 20 == 0) {
+		IOLog("SPES BATTERY: max77729 %u%% %umV %dmA temp=%d cycles=%u ok=%#x dtls=%#x "
+		    "(raw soc=%#x vcell=%#x cur=%#x temp=%#x) external=%d charging=%d\n",
+		    percent, mv, ma, fTempCentiC, cyclesOk ? cycles / 100u : 0u, ok, dtls,
+		    soc, vcell, cur, temp, external, charging);
+	}
+	return true;
+}
+
+/* Board 0x40022: Topaz's chips, Topaz's arithmetic (topaz 0091, MakrSas/topaz-woa gauge.c). */
+bool
+SweetBattery::pollSpesSm(void)
+{
+	uint16_t soc, volt, cur;
+	uint8_t st = 0;
+	if (!spesWord(0x71, 0x05, &soc) || !spesWord(0x71, 0x07, &volt) ||
+	    !spesWord(0x71, 0x08, &cur)) {
+		return false;
+	}
+	bool chgOk = spes_i2c1_read(0x6a, 0x0b, &st, 1) == 0;
+	unsigned percent = (soc & 0x8000u) ? 0 : ((soc >> 8) & 0x7fu);
+	unsigned mv = 1800u * (volt & 0x7fffu) / 19622u + 2700u;
+	int ma = (int)((cur & 0x7fffu) * 1000u / 4088u * 2u);
+	if (cur & 0x8000u) {
+		ma = -ma;
+	}
+	if (percent > 100 || mv < 2800 || mv > 4600) {
+		return false;
+	}
+	unsigned vbus = (st >> 5) & 7u, chrg = (st >> 3) & 3u;
+	bool external = chgOk && vbus >= 1 && vbus <= 6 && (st & 4u);
+	bool charging = external && (chrg == 1 || chrg == 2);
+	bool done = external && chrg == 3;
+	publish(done ? 100 : percent, mv, ma, external, external, charging, done, true, true);
+	if (fSpesLogs++ % 20 == 0) {
+		IOLog("SPES BATTERY: sm5602 %u%% %umV %dmA chg=%#x (raw soc=%#x volt=%#x cur=%#x) "
+		    "external=%d charging=%d\n", percent, mv, ma, st, soc, volt, cur, external, charging);
+	}
+	return true;
+}
