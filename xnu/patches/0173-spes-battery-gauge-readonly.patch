+static LCK_GRP_DECLARE(spes_i2c1_grp, "spes_i2c1");
+static LCK_MTX_DECLARE(spes_i2c1_lock, &spes_i2c1_grp);
+static vm_offset_t spes_i2c1_se;       /* set once the bus has been set up */
+static bool spes_i2c1_dead;            /* an engine that did not come back idle: hands off */
 
