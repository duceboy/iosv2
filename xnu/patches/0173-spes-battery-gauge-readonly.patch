+
+void
+spes_amp_init(void)
+{
+	int on = 0;
+	if (!PE_parse_boot_argn("spesamp", &on, sizeof(on)) || on < 1 || on > 2) {
+		return;
+	}
+	lck_mtx_lock(&spes_i2c1_lock);
+	amp_init_locked(on);
+	lck_mtx_unlock(&spes_i2c1_lock);
+}
+
+/*
+ * 0173: SE1 as a read-only bus for the battery chips (iokit/Kernel/arm/SweetBattery.cpp,
+ * boot-arg spesbattery=1). Nothing below writes to any chip: the only bytes sent are a chip's
+ * address and the register number to read from.
+ *
+ * spes_i2c1_up() brings the bus up exactly as spes_amp_init() does (same clock vote, same
+ * RCG/branch checks, same firmware and FIFO checks, same pin rule, amp_se_setup) and is safe to
+ * call whether or not spesamp ran, and more than once. 0 = usable.
+ */
+static int
+i2c1_up_locked(void)
+{
+	if (spes_i2c1_dead) {
+		return 1;
+	}
+	if (spes_i2c1_se != 0) {
+		return 0;
+	}
+	vm_offset_t vpg = ml_io_map(AMP_GCC_PA + (AMP_GCC_VOTE & ~0xfffu), 0x1000u);
+	vm_offset_t rpg = ml_io_map(AMP_GCC_PA + (AMP_RCG & ~0xfffu), 0x1000u);
+	if (vpg == 0 || rpg == 0) {
+		printf("SPES I2C1: no GCC mapping\n");
+		return 1;
+	}
+	amp_wr(vpg, AMP_GCC_VOTE & 0xfffu, amp_rd(vpg, AMP_GCC_VOTE & 0xfffu) | AMP_GCC_BITS);
+	if ((amp_rd(rpg, (AMP_RCG & 0xfffu) + 4u) & 0x71fu) != 1u) {
+		amp_wr(rpg, (AMP_RCG & 0xfffu) + 4u, 1u);  /* XO, divider 1: 19.2 MHz */
+		amp_wr(rpg, (AMP_RCG & 0xfffu), amp_rd(rpg, (AMP_RCG & 0xfffu)) | 1u);
+		if (!amp_wait_clear(rpg, (AMP_RCG & 0xfffu), 1u)) {
+			printf("SPES I2C1: RCG update timeout\n");
+			return 1;
+		}
+	}
+	if (!amp_wait_clear(rpg, (AMP_RCG & 0xfffu) - 4u, 1u << 31)) {
+		printf("SPES I2C1: SE1 branch halted (%#x)\n", amp_rd(rpg, (AMP_RCG & 0xfffu) - 4u));
+		return 1;
+	}
+	vm_offset_t se = ml_io_map(AMP_SE_PA, 0x4000);
+	if (se == 0) {
+		printf("SPES I2C1: no SE1 mapping\n");
+		return 1;
+	}
+	uint32_t fw = amp_rd(se, 0x068), tx = amp_rd(se, 0xe24), rx = amp_rd(se, 0xe28);
+	if (((fw >> 8) & 0xffu) != 3u || (amp_rd(se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u) {
+		printf("SPES I2C1: no usable I2C firmware on SE1 (fw %#x tx %#x rx %#x)\n", fw, tx, rx);
+		return 1;
+	}
+	vm_offset_t west = ml_io_map(AMP_WEST_PA, 0x6000);
+	if (west == 0) {
+		printf("SPES I2C1: no TLMM mapping\n");
+		return 1;
+	}
+	for (uint32_t pin = 4; pin <= 5; pin++) {
+		uint32_t cfg = amp_rd(west, pin * 0x1000u);
+		if (((cfg >> 2) & 0xfu) != 1u) {
+			uint32_t want = (cfg & ~0x3cu) | (1u << 2) | 3u;   /* qup1, pull-up */
+			if (cfg & (1u << 11)) {
+				want |= 1u << 12;
+			}
+			amp_wr(west, pin * 0x1000u, want);
+		}
+		if (!(amp_rd(west, pin * 0x1000u + 4u) & 1u)) {
+			printf("SPES I2C1: GPIO%u pad low while idle; bus not used\n", pin);
+			return 1;
+		}
+	}
+	if (!amp_se_setup(se, rx)) {
+		return 1;
+	}
+	spes_i2c1_se = se;
+	return 0;
+}
+
+int
+spes_i2c1_up(void)
+{
+	lck_mtx_lock(&spes_i2c1_lock);
+	int err = i2c1_up_locked();
+	lck_mtx_unlock(&spes_i2c1_lock);
+	return err;
+}
+
+/*
+ * Read len (1..4) bytes starting at register reg: the register number is written with the bus
+ * kept (repeated START), then len bytes are read in one message. GENI packs received bytes
+ * into the FIFO word lowest byte first (RX packing = TX packing, amp_se_setup), so byte i is
+ * bits 8i..8i+7; i2c-qcom-geni.c and Topaz's sweet_i2c1.c read the same way. The 16-bit
+ * registers of the gauges are least significant byte first on the wire.
+ * 0 done, 1 NACK, 2 other error, 3 engine stuck (the bus is then left alone for good), 4 not up.
+ */
+int
+spes_i2c1_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (buf == NULL || len < 1 || len > 4) {
+		return 2;
+	}
+	lck_mtx_lock(&spes_i2c1_lock);
+	vm_offset_t se = spes_i2c1_se;
+	int err = 4;
+	if (se != 0) {
+		err = amp_msg(se, addr, false, &reg);
+	}
+	if (se != 0 && err == 0) {
+		err = 2;
+		if (!amp_wait_clear(se, SE_STATUS, 1u)) {
+			err = 3;
+		} else {
+			bool got = false;
+			amp_wr(se, SE_IRQ_CLR, 0xffffffffu);
+			amp_wr(se, SE_TX_WM, 0);
+			amp_wr(se, SE_RX_LEN, len);
+			amp_wr(se, SE_CMD, (2u << 27) | ((uint32_t)addr << 9));
+			unsigned i;
+			for (i = 0; i < 5000; i++) {
+				uint32_t irq = amp_rd(se, SE_IRQ);
+				if (irq & SE_ERRORS) {
+					for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); j++) {
+						delay(1);
+						irq = amp_rd(se, SE_IRQ);
+					}
+					err = (irq & SE_NACK) ? 1 : 2;
+					if ((irq & SE_DONE) && !(amp_rd(se, SE_STATUS) & 1u)) {
+						amp_wr(se, SE_IRQ_CLR, irq);
+					} else if (!amp_abort(se)) {
+						err = 3;
+					}
+					break;
+				}
+				if (!got && (amp_rd(se, SE_RX_COUNT) & 0x1ffffffu)) {
+					uint32_t word = amp_rd(se, SE_RX);
+					for (unsigned b = 0; b < len; b++) {
+						buf[b] = (uint8_t)(word >> (8u * b));
+					}
+					got = true;
+				}
+				if (irq & SE_DONE) {
+					amp_wr(se, SE_IRQ_CLR, irq);
+					err = got ? 0 : 2;
+					break;
+				}
+				amp_wr(se, SE_IRQ_CLR, irq & (SE_TX_WM_IRQ | (3u << 26)));
+				delay(1);
+			}
+			if (i == 5000) {
+				err = amp_abort(se) ? 2 : 3;
+			}
+		}
+	}
+	if (err == 3) {
+		printf("SPES I2C1: engine stuck; SE1 is not used again this boot\n");
+		spes_i2c1_se = 0;
+		spes_i2c1_dead = true;
+	}
+	lck_mtx_unlock(&spes_i2c1_lock);
+	return err;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
