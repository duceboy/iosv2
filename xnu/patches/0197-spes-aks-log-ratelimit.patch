spes: AppleKeyStore stub logs only the first 200 calls, then failures (0197).

Every SweetKeyStore user-client call was logged (ReportCrash, contextstored, coreduetd, searchd ...):
about ten lines a second in steady state, each a printf plus a live-log packet. Now the first 200
calls (enough to see the boot-time pattern) and then only failures (at most 300).

diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index 73d9267..6a4272a 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -275,10 +275,19 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	/*
+	 * SPES 0197: log the first 200 calls, then only failures (capped). Every call was logged: ~10 lines
+	 * a second in steady state (ReportCrash, contextstored, coreduetd, searchd), each a printf plus a
+	 * live-log packet.
+	 */
+	static uint32_t spes_aks_logged, spes_aks_failed;
+	uint32_t nlog = OSIncrementAtomic((volatile SInt32 *)&spes_aks_logged);
+	if (nlog < 200 || (ret != kIOReturnSuccess && OSIncrementAtomic((volatile SInt32 *)&spes_aks_failed) < 300)) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	}
 	return ret;
 }
 #endif /* SWEET */
