+/* (glbox) Part of a target has been written: the box that is copied into its surface grows around it. */
+static void
+box_add(struct image *image, long long x, long long y, long long width, long long height)
+{
+	long long right = x + width, top = y + height;
+
+	if (image->box_all) {
+		return;
+	}
+	x = x < 0 ? 0 : x;
+	y = y < 0 ? 0 : y;
+	right = right > image->width ? image->width : right;
+	top = top > image->height ? image->height : top;
+	if (right <= x || top <= y) {
+		return;                 /* (nothing of it is in the picture) */
+	}
+	if (image->box[2] <= image->box[0] || image->box[3] <= image->box[1]) {
+		image->box[0] = (GLint)x;
+		image->box[1] = (GLint)y;
+		image->box[2] = (GLint)right;
+		image->box[3] = (GLint)top;
+	} else {
+		image->box[0] = x < image->box[0] ? (GLint)x : image->box[0];
+		image->box[1] = y < image->box[1] ? (GLint)y : image->box[1];
+		image->box[2] = right > image->box[2] ? (GLint)right : image->box[2];
+		image->box[3] = top > image->box[3] ? (GLint)top : image->box[3];
 	}
+	if (image->box[0] == 0 && image->box[1] == 0 && image->box[2] == image->width && image->box[3] == image->height) {
+		image->box_all = true;
+	}
 }
 
+/* (glbox) A draw or a clear into a target, which is bound: inside the scissor box if there is one, else anywhere. */
+static void
+box_drawn(struct image *image)
+{
+	GLint box[4] = { 0, 0, 0, 0 };
+
+	if (image->box_all) {
+		return;
+	}
+	if (!glIsEnabled(GL_SCISSOR_TEST)) {
+		image->box_all = true;
+		return;
+	}
+	glGetIntegerv(GL_SCISSOR_BOX, box);
+	box_add(image, box[0], box[1], box[2], box[3]);
+}
+
+/* (glbox) A texture is filled or copied into, not drawn into: a part of it (`whole` false), or who knows. */
+static void
+box_filled(struct eagl *e, GLuint texture, bool whole, GLint x, GLint y, GLsizei width, GLsizei height)
+{
+	struct image *image;
+
+	if (!box_targets || texture == 0 || e->image_count == 0 || (image = image_of(e, texture)) == NULL || image->mirror == 0) {
+		return;
+	}
+	if (whole) {
+		image->box_all = true;
+	} else {
+		box_add(image, x, y, width, height);
+	}
+}
+
+/* (glbox) A call that writes where it is not followed (eagl_enter()): every target is copied whole the next time. */
+static void
+box_unfollowed(struct eagl *e)
+{
+	e->box_unfollowed++;
+	for (unsigned i = 0; i < e->image_count; i++) {
+		e->images[i].box_all = true;
+	}
+}
+
+/*
+ * (glbox) A target is about to be copied into its surface. Any other texture that copies into the
+ * same surface no longer holds what the surface does outside its own box: all of it the next time.
+ */
+static void
+box_strangers(struct eagl *e, struct image *image)
+{
+	uint32_t surface = IOSurfaceGetID(image->surface);
+
+	for (unsigned i = 0; i < e->image_count; i++) {
+		struct image *other = &e->images[i];
+
+		if (other != image && other->mirror != 0 && !other->box_all && IOSurfaceGetID(other->surface) == surface) {
+			other->box_all = true;
+			e->box_strangers++;
+		}
+	}
+}
